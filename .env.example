# Copy this to .env and fill in your keys.
# NEVER commit .env — it is gitignored.

# Database — Phase 1 (PostgreSQL + pgvector)
# When set, overrides the SQLite backend automatically.
# docker-compose sets this automatically; set manually for cloud deploys.
# DATABASE_URL=postgresql://lens:your_password@localhost:5432/lens_memory
# POSTGRES_PASSWORD=your_strong_password

# API auth — set before deploying; omit to run without auth (dev mode only)
# Generate with: python3 -c "import secrets; print('lens-' + secrets.token_urlsafe(32))"
LENS_API_KEY=lens-...

# Redis — optional session persistence across restarts (e.g. Upstash or self-hosted).
# Without this, sessions live only in memory and are lost on restart.
# REDIS_URL=redis://localhost:6379

# Per-IP rate limit on /analyze endpoints (default: 10/minute).
# Raise for paid Gemini tier, e.g. "60/minute".
# LENS_RATE_LIMIT=10/minute

# Google Gemini — used by all agents (Vision, Memory, Search, Fusion)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ...

# Tavily — used by Search agent for live web results
TAVILY_API_KEY=tvly-...

# LangSmith — optional, for tracing
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=lens-os-phase0
